                                                          ]
                                                     } # End of R_ANKLE_R_LINK
                                                     DEF R_FOOT_P Joint {
                                                        jointType "rotate"
                                                        jointId 13
                                                        jointAxis "Y"
                                                        translation 0 0 0.0
                                                        rotation 1 0 0 0
                                                        llimit [-1.7453292520] # -100[deg]
                                                        ulimit [ 0.6981317008] #  40[deg]
                                                        lvlimit [-9]
                                                        uvlimit [ 9]
                                                        gearRatio 1
                                                        rotorInertia 1.0
                                                        children [
                                                           DEF R_FOOT_P_LINK Segment {
                                                              mass 0.5
                                                              centerOfMass 0 0 0
                                                              momentsOfInertia [0.0003 0 0  0 0.001 0  0 0 0.001]
                                                              children [
                                                                 DEF rfsensor ForceSensor {
                                                                    translation 0 0 -0.05
                                                                    rotation 0 -1 0 0
                                                                    sensorId 0
                                                                 }
                                                                 #Inline { url "FootP.stl" }
																 Inline { url "FootP_flat.stl" }
                                                                ]
                                                           } # End of R_ANKLE_P_LINK
                                                          ]
                                                     } # End of R_ANKLE_P
                                                    ]
                                               } # End of R_ANKLE_R
                                              ]
                                         } # End of R_KNEE_P
                                        ]
                                   } # End of R_CROTCH_P
                                  ]
                             } # End of R_CROTCH_R
                            ]
                       } # End of R_CROTCH_Y

                       #========== LLEG START ==========#

                       DEF L_UPPERLEG_Y Joint {
                          jointType "rotate"
                          jointId 0
                          jointAxis "Z"
                          translation 0 0.1 -0.1
                          rotation 0 0 1 0
                          llimit [-3.14159265358979] #TODO -175[deg]
                          ulimit [3.14159265358979]  #TODO  175[deg]
                          lvlimit [-9]
                          uvlimit [ 9]
                          gearRatio 1
                          rotorInertia 1.0
                          children [
                             DEF L_UPPERLEG_Y_LINK Segment {
                                mass 0.5
                                centerOfMass 0 0 0
                                momentsOfInertia [0.0003 0 0  0 0.0003 0  0 0 0.0003]
                                children [
                                   Inline { url "UpperlegY.stl" }
                                  ]
                             } # End of L_CROTCH_Y_LINK
                             DEF L_UPPERLEG_R Joint {
                                jointType "rotate"
                                jointId 1
                                jointAxis "X"
                                translation 0.0 0.0 -0.0
                                rotation 1 0 0 0
                                llimit [-0.523599] #  -30[deg]
                                ulimit [ 0.523599] #   30[deg]
                                lvlimit [-9]
                                uvlimit [ 9]
                                gearRatio 1
                                rotorInertia 1.0
                                children [
                                   DEF L_UPPERLEG_R_LINK Segment {
                                      mass 0.5
                                      centerOfMass 0 0 0
                                      momentsOfInertia [0.0003 0 0  0 0.0003 0  0 0 0.0003]
                                      children [
                                         Inline { url "UpperlegR.stl" }
                                        ]
                                   } # End of L_CROTCH_R_LINK
                                   DEF L_UPPERLEG_P Joint {
                                      jointType "rotate"
                                      jointId 2
                                      jointAxis "Y"
                                      translation 0 0 0
                                      rotation 0 1 0 0
                                      llimit [-1.919862] # -110[deg]
                                      ulimit [ 0.523599] #  30[deg]
                                      lvlimit [-9]
                                      uvlimit [ 9]
                                      gearRatio 1
                                      rotorInertia 1.0
                                      children [
                                         DEF L_UPPERLEG_P_LINK Segment {
                                            mass      1.5
                                            centerOfMass 0 0 -0.15
                                            momentsOfInertia [0.01 0 0  0 0.01 0  0 0 0.001]
                                            children [
                                               Inline { url "UpperlegP.stl" }
                                              ]
                                         } # End of L_CROTCH_P_LINK

                                         DEF L_LOWERLEG_P Joint {
                                            jointType "rotate"
                                            jointId 3
                                            jointAxis "Y"
                                            translation 0 0 -0.3
                                            rotation 0 1 0 0
                                            llimit [0.0]          #   0[deg] ## should be zero for cylinder length calculation
                                            ulimit [2.44346] # 140[deg]
                                            lvlimit [-12]
                                            uvlimit [ 12]
                                            gearRatio 1
                                            rotorInertia 1.0
                                            children [
                                               DEF L_LOWERLEG_P_LINK Segment {
                                                  mass      1.5
                                                  centerOfMass 0 0 -0.2
                                                  momentsOfInertia [0.02 0 0  0 0.02 0  0 0 0.002]
                                                  children [
                                                     Inline { url "LowerlegP.stl" }
                                                    ]
                                               } # End of L_KNEE_P_LINK
                                               DEF L_FOOT_R Joint {
                                                  jointType "rotate"
                                                  jointId 4
                                                  jointAxis "X"
                                                  translation 0 0 -0.4
                                                  rotation 0 1 0 0
                                                  llimit [-0.523599] # -30[deg]
                                                  ulimit [ 0.523599] #  30[deg]
                                                  lvlimit [-9]
                                                  uvlimit [ 9]
                                                  gearRatio 1
                                                  rotorInertia 1.0
                                                  children [
                                                     DEF L_FOOT_R_LINK Segment {
                                                        mass 0.5
                                                        centerOfMass 0 0 0
                                                        momentsOfInertia [0.0003 0 0  0 0.0003 0  0 0 0.0003]

                                                        children [
                                                           Inline { url "FootR.stl" }
                                                          ]
                                                     } # End of L_ANKLE_R_LINK
                                                     DEF L_FOOT_P Joint {
                                                        jointType "rotate"
                                                        jointId 5
                                                        jointAxis "Y"
                                                        translation 0 0 0.0
                                                        rotation 1 0 0 0
                                                        llimit [-1.7453292520] # -100[deg]
                                                        ulimit [ 0.6981317008] #  40[deg]
                                                        lvlimit [-9]
                                                        uvlimit [ 9]
                                                        gearRatio 1
                                                        rotorInertia 1.0
                                                        children [
                                                           DEF L_FOOT_P_LINK Segment {
                                                              mass 0.5
                                                              centerOfMass 0 0 0
                                                              momentsOfInertia [0.0003 0 0  0 0.001 0  0 0 0.001]
                                                              children [
                                                                 DEF lfsensor ForceSensor {
                                                                    translation 0 0 -0.05
                                                                    rotation 0 -1 0 0
                                                                    sensorId 1
                                                                 }
                                                                 #Inline { url "FootP.stl" }
																 Inline { url "FootP_flat.stl" }
                                                                ]
                                                           } # End of L_ANKLE_P_LINK
                                                          ]
                                                     } # End of L_ANKLE_P
                                                    ]
                                               } # End of L_ANKLE_R
                                              ]
                                         } # End of L_KNEE_P
                                        ]
                                   } # End of L_CROTCH_P
                                  ]
                             } # End of L_CROTCH_R
                            ]
                       } # End of L_CROTCH_Y
                      ]
                 }
                ] # End of [humanoidBody]

   joints [
