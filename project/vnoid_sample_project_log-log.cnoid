items:
  id: 0
  name: "RootItem"
  plugin: Base
  class: RootItem
  is_builtin_item: true
  children:
    -
      id: 1
      name: "World"
      plugin: Body
      class: WorldItem
      data:
        collision_detection: false
        collision_detector: AISTCollisionDetector
        default_material_table_file: "${SHARE}/default/materials.yaml"
      children:
        -
          id: 2
          name: "Floor"
          plugin: Body
          class: BodyItem
          is_checked: true
          data:
            file: "vnoid_sample_project_log-log/Floor/Floor.body"
            format: CHOREONOID-BODY
            rootPosition: [ 0, 0, 0 ]
            rootAttitude: [
              1, 0, 0,
              0, 1, 0,
              0, 0, 1 ]
            jointDisplacements: [ -1.93437, 0, -1.93436, 0, 1.93437 ]
            initialRootPosition: [ 0, 0, 0 ]
            initialRootAttitude: [
              1, 0, 0,
              0, 1, 0,
              0, 0, 1 ]
            fix_root: true
            collisionDetection: true
            selfCollisionDetection: false
            lock_location: true
            scene_sensitive: true
        -
          id: 3
          name: "AISTSimulator"
          plugin: Base
          class: FolderItem
          children:
            -
              id: 4
              name: "WorldLogFile"
              plugin: Body
              class: WorldLogFileItem
              is_selected: true
              is_checked: true
              data:
                file: "vnoid_sample_project_log-log/vnoid_sample_project_log"
                format: CNOID-WORLD-LOG
                time_stamp_suffix: false
                recording_frame_rate: 0
                live_playback_read_interval_ms: 10
                live_playback_read_timeout: 0
        -
          id: 5
          name: "Unitychan"
          plugin: Body
          class: BodyItem
          is_checked: true
          data:
            file: "vnoid_sample_project_log-log/Unitychan/Unitychan.body"
            format: CHOREONOID-BODY
            currentBaseLink: "HIPS"
            rootPosition: [ 13.2707777, -0.892213583, 0.19652611 ]
            rootAttitude: [
              -0.226080567, 0.0782940392, -0.970957056,
              -0.134453606, 0.984715951, 0.110710084,
              0.964784841, 0.155578077, -0.212098225 ]
            jointDisplacements: [
              0.0363434, 1.47343, 0.0390199, 0.00619235, 46.7451, -62.9318, 0.0787411, -108.822, -82.1464, 49.1914,
              -26.1402, 46.4631, 62.2586, -0.0973864, -109.136, 82.0122, 49.6884, 26.6533, -1.09238, -2.71248,
              -92.5119, 4.02568, 37.2058, 0.875757, -1.04355, -2.68179, -94.1722, 2.36801, 29.7442, 0.85722 ]
            initialRootPosition: [ 13.2707777, -0.892213583, 0.19652611 ]
            initialRootAttitude: [
              -0.226080546, 0.0782940396, -0.970957056,
              -0.134453605, 0.984715952, 0.110710082,
              0.964784841, 0.155578075, -0.212098204 ]
            fix_root: false
            collisionDetection: true
            selfCollisionDetection: false
            lock_location: false
            scene_sensitive: true
          children:
            -
              id: 6
              name: "SensorVisualizer"
              plugin: Body
              class: SensorVisualizerItem
              data:
                sub_items: [ ]
            -
              id: 7
              name: "BodyTrackingCamera"
              plugin: Body
              class: BodySyncCameraItem
              is_checked: true
              data:
                camera_type: Perspective
                translation: [ 13.2708, -0.892213, -0.703474 ]
                rotation: [ 0.0156561, 0.996498, 0.0821342, 0.000463575 ]
                field_of_view: 0.785398
                near_clip_distance: 0.04
                far_clip_distance: 200
                interactive_viewpoint_change: true
                target_link: ""
                parallel_tracking: true
                local_translation: [ -0.868306, -0.14002, 0.190889 ]
                local_rotation: [ -0.0230338, 0.993751, 0.109218, 103.105 ]
views:
  -
    id: 0
    name: "Image"
    plugin: Base
    class: ImageView
  -
    id: 1
    plugin: Base
    class: ItemPropertyView
    mounted: true
  -
    id: 2
    plugin: Base
    class: ItemTreeView
    mounted: true
    state:
      expanded: [ 1, 3, 5, 6 ]
  -
    id: 3
    plugin: Base
    class: LocationView
    state:
      show_rpy: true
      unique_rpy: false
      show_quaternion: false
      show_rotation_matrix: false
      coordinate: parent
  -
    id: 4
    plugin: Base
    class: MessageView
    mounted: true
  -
    id: 5
    plugin: Base
    class: MultiSE3SeqGraphView
    state:
      mode: view
      editMode: freeLine
      original: true
      velocity: false
      acceleration: false
      limits: true
      grid: true
      gridWidth: 0.2
      gridHeight: 0.2
      lineWidth: 1
      rulers: false
      sync: true
      controlPointStep: 1
      controlPointOffset: 0
      controlPointHeighlight: false
      scrollMode: continuous
      lower: -10
      upper: 10
      visibleElements: [ 0, 1, 2 ]
  -
    id: 6
    plugin: Base
    class: MultiValueSeqGraphView
    state:
      mode: view
      editMode: freeLine
      original: true
      velocity: false
      acceleration: false
      limits: true
      grid: true
      gridWidth: 0.2
      gridHeight: 0.2
      lineWidth: 1
      rulers: false
      sync: true
      controlPointStep: 1
      controlPointOffset: 0
      controlPointHeighlight: false
      scrollMode: continuous
      lower: -10
      upper: 10
  -
    id: 7
    plugin: Base
    class: SceneView
    mounted: true
    state:
      operation_mode: view
      viewpoint_operation_mode: third_person
      focus_position: [ 5.40861, -1.92584, -0.00334179 ]
      visible_polygon_elements: [ face ]
      highlighting: false
      collision_lines: false
      cameras:
        -
          camera: [ System, Perspective ]
          eye: [ 11.2804, -3.95892, 5.01322 ]
          direction: [ -0.00395965, 0.490464, -0.871452 ]
          up: [ -0.00703524, 0.871424, 0.49048 ]
        -
          camera: [ System, Orthographic ]
          is_current: true
          ortho_height: 12.1306
      lighting_mode: normal
      culling_mode: enabled
      shading_mode: smooth
      world_light: true
      world_light_intensity: 0.5
      ambient_light: true
      ambient_light_intensity: 0.3
      head_light: true
      head_light_intensity: 0.75
      world_light_shadow: true
      shadow_lights:
        - { index: 0, enabled: false }
        - { index: 1, enabled: false }
      background_color: [ 0.5, 0.666667, 0.5 ]
      line_width: 1
      point_size: 1
      field_of_view: 40
      clip_distances: [ 0.04, 200 ]
      floorGrid: false
      floorGridSpan: 10
      floorGridInterval: 0.5
      xzGrid: false
      xzGridSpan: 10
      xzGridInterval: 0.5
      yzGrid: false
      yzGridSpan: 10
      yzGridInterval: 0.5
      xy_grid_color: [ 0.9, 0.9, 0.9 ]
      xz_grid_color: [ 0.9, 0.9, 0.9 ]
      yz_grid_color: [ 0.9, 0.9, 0.9 ]
  -
    id: 8
    plugin: Base
    class: TaskView
    state:
      layoutMode: horizontal
      isAutoMode: false
  -
    id: 9
    plugin: Base
    class: TextEditView
  -
    id: 10
    plugin: Body
    class: BodyLinkView
    mounted: true
    state:
      showRotationMatrix: false
  -
    id: 11
    plugin: Body
    class: BodyStateView
    mounted: true
  -
    id: 12
    plugin: Body
    class: JointDisplacementView
    mounted: true
    state:
      show_joint_ids: true
      show_joint_names: false
      overlap_joint_names: false
      show_sliders: true
      show_dials: false
      show_phases: true
      limit_ranges: false
      show_selected_joints: false
  -
    id: 13
    plugin: Body
    class: JointStateView
    mounted: true
  -
    id: 14
    plugin: Body
    class: LinkDeviceListView
    mounted: true
    state:
      element_type: link
      listing_mode: list
  -
    id: 15
    plugin: Body
    class: LinkGraphView
    state:
      mode: view
      editMode: freeLine
      original: true
      velocity: false
      acceleration: false
      limits: true
      grid: true
      gridWidth: 0.2
      gridHeight: 0.2
      lineWidth: 1
      rulers: false
      sync: true
      controlPointStep: 1
      controlPointOffset: 0
      controlPointHeighlight: false
      scrollMode: continuous
      lower: -10
      upper: 10
      visible_elements: [ 0, 1, 2 ]
  -
    id: 16
    plugin: Body
    class: LinkPositionView
    state:
      coordinate_mode: world
      preferred_coordinate_mode: base
      show_rpy: true
      unique_rpy: false
      show_quaternion: false
      show_rotation_matrix: false
      target_link_type: ik_link
  -
    id: 17
    plugin: Body
    class: LinkPropertyView
  -
    id: 18
    plugin: Python
    class: PythonConsoleView
toolbars:
  "TimeBar":
    current_time: 96.297
    min_time: 0
    max_time: 838.303
    frame_rate: 1000
    playback_frame_rate: 60
    idle_loop_driven_mode: false
    playback_speed_ratio: 1
    sync_to_ongoing_updates: true
    auto_expansion: true
  "LeggedBodyBar":
    stanceWidth: 0.15
  "KinematicsBar":
    forward_kinematics: true
    inverse_kinematics: true
    preset_kinematics: true
    enablePositionDragger: true
    penetrationBlock: false
    collisionLinkHighlight: false
    snapDistance: 0.025
    penetrationBlockDepth: 0.0005
    lazyCollisionDetectionMode: true
Body:
  "BodySelectionManager":
    current_body_item: 5
    current_link: "HIPS"
  "KinematicFaultChecker":
    checkJointPositions: true
    angleMargin: 0
    translationMargin: 0
    checkJointVelocities: true
    velocityLimitRatio: 100
    targetJoints: all
    checkSelfCollisions: true
    onlyTimeBarRange: false
  "OperableSceneBody":
    scene_bodies:
      -
        body_item: 2
        show_cm: false
        show_cm_projection: false
        show_zmp: false
      -
        body_item: 5
        show_cm: false
        show_cm_projection: false
        show_zmp: false
  "SplineFilterDialog":
    isInputFrameRateSpecified: false
    inputFrameRate: 200
    isOutputFrameRateSpecified: false
    outputFrameRate: 200
viewAreas:
  -
    type: embedded
    tabs: true
    contents:
      type: splitter
      orientation: horizontal
      sizes: [ 323, 1521 ]
      children:
        -
          type: splitter
          orientation: vertical
          sizes: [ 508, 508 ]
          children:
            -
              type: pane
              views: [ 2 ]
            -
              type: pane
              views: [ 1, 14 ]
              current: 1
        -
          type: splitter
          orientation: vertical
          sizes: [ 725, 291 ]
          children:
            -
              type: pane
              views: [ 10, 13, 7 ]
              current: 7
            -
              type: pane
              views: [ 4, 11, 12 ]
              current: 12
layoutOfToolBars:
  rows:
    -
      - { name: "FileBar", x: 0, priority: 0 }
      - { name: "ScriptBar", x: 48, priority: 0 }
      - { name: "TimeBar", x: 96, priority: 0 }
      - { name: "SceneBar", x: 1020, priority: 0 }
    -
      - { name: "GraphBar", x: 0, priority: 0 }
      - { name: "SimulationBar", x: 110, priority: 0 }
      - { name: "BodyBar", x: 313, priority: 0 }
      - { name: "KinematicsBar", x: 581, priority: 0 }
