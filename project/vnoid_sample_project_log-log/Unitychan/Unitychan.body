format: ChoreonoidBody
format_version: 2.0
angle_unit: degree
name: "Unitychan"
root_link: "HIPS"
links:
  -
    name: "HIPS"
    translation: [ 0, 0, 0.9 ]
    joint_name: "HIPS"
    joint_type: free
    mass: 10
    center_of_mass: [ 0, 0, 0 ]
    inertia: [
      0.04, 0, 0,
      0, 0.04, 0,
      0, 0, 0.04 ]
